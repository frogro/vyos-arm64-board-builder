#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="/run/vyos-kvm-over-ip/video.env"
[[ -r "${ENV_FILE}" ]] || {
    echo "ERROR: KVM video runtime configuration is missing: ${ENV_FILE}" >&2
    exit 1
}

# Generated by the trusted VyOS conf_mode script.
# shellcheck disable=SC1090
source "${ENV_FILE}"

BACKEND="${KVM_VIDEO_BACKEND:?}"
PROVIDER="${KVM_VIDEO_PROVIDER:-generic-v4l2}"
DEVICE="${KVM_VIDEO_DEVICE:-}"
RESOLUTION="${KVM_VIDEO_RESOLUTION:-}"
FRAMERATE="${KVM_VIDEO_FRAMERATE:-}"
BITRATE="${KVM_VIDEO_BITRATE:-8000}"
GOP="${KVM_VIDEO_GOP:-60}"
LISTEN_ADDRESS="${KVM_VIDEO_LISTEN_ADDRESS:-0.0.0.0}"
PORT="${KVM_VIDEO_PORT:-8889}"
USTREAMER_QUALITY="${KVM_VIDEO_USTREAMER_QUALITY:-80}"

detect_ffmpeg_input_format()
{
    local dev="$1"
    local fourcc

    fourcc="${FOURCC}"

    case "${fourcc}" in
        BGR3) printf 'bgr24\n' ;;
        RGB3) printf 'rgb24\n' ;;
        NV12) printf 'nv12\n' ;;
        YUYV) printf 'yuyv422\n' ;;
        UYVY) printf 'uyvy422\n' ;;
        MJPG) printf 'mjpeg\n' ;;
        *)    printf '\n' ;;
    esac
}


sync_provider_capture_timings()
{
    # The Synopsys HDMI-RX driver keeps the active DV timing separately from
    # the timing currently detected on the HDMI input. Adopt the detected
    # source timing before any backend opens the V4L2 capture device.
    if [[ "${SOURCE_PROVIDER}" != "rk3588-synopsys-hdmirx" ]]; then
        return 0
    fi

    command -v v4l2-ctl >/dev/null 2>&1 || {
        echo "ERROR: v4l2-ctl is required for HDMI-RX timing synchronization" >&2
        return 1
    }

    echo "KVM HDMI-RX: synchronizing DV timings with detected input on ${DEVICE}" >&2
    v4l2-ctl -d "${DEVICE}" --set-dv-bt-timings query >/dev/null || {
        echo "ERROR: failed to synchronize HDMI-RX DV timings on ${DEVICE}" >&2
        return 1
    }
}

# Host provider controls encoders; the selected source controls HDMI supervision.
selection="$(/usr/bin/python3 /usr/local/libexec/vyos-kvm-capture.py --backend "${BACKEND}" --device "${DEVICE}" --resolution "${RESOLUTION}" --framerate "${FRAMERATE}")"
eval "${selection}"

# Scope signal supervision to the provider with HDMI DV-timing support.
if [[ "${SOURCE_PROVIDER}" == "rk3588-synopsys-hdmirx" && "${KVM_VIDEO_SUPERVISED:-0}" != 1 ]]; then
    exec /usr/bin/python3 /usr/local/libexec/vyos-kvm-video-supervisor.py "${DEVICE}" "${BACKEND}" "$0"
fi

sync_provider_capture_timings

echo "KVM video backend=${BACKEND} host=${PROVIDER} source=${SOURCE_PROVIDER} device=${DEVICE} format=${FOURCC}" >&2

case "${BACKEND}" in
    ustreamer)
        USTREAMER="/usr/local/bin/ustreamer"
        [[ -x "${USTREAMER}" ]] || {
            echo "ERROR: ustreamer is missing: ${USTREAMER}" >&2
            exit 1
        }

        args=(
            "${USTREAMER}"
            --device="${DEVICE}"
            --host="${LISTEN_ADDRESS}"
            --port="${PORT}"
            --quality="${USTREAMER_QUALITY}"
        )

        # HDMI RX can expose BGR24 only; uStreamer otherwise defaults to YUYV.
        # Derive the format from the selected V4L2 device, not the board name.
        case "$(detect_ffmpeg_input_format "${DEVICE}")" in
            bgr24) args+=(--format=BGR24) ;;
            rgb24) args+=(--format=RGB24) ;;
            yuyv422) args+=(--format=YUYV) ;;
            uyvy422) args+=(--format=UYVY) ;;
            mjpeg) args+=(--format=MJPEG) ;;
        esac

        [[ -n "${RESOLUTION}" ]] && args+=(--resolution="${RESOLUTION}")
        [[ -n "${FRAMERATE}" ]] && args+=(--desired-fps="${FRAMERATE}")

        exec "${args[@]}"
        ;;

    ffmpeg)
        if [[ "${PROVIDER}" == "rk3588-synopsys-hdmirx" &&
              -x /usr/local/bin/ffmpeg-rockchip ]]; then
            FFMPEG="/usr/local/bin/ffmpeg-rockchip"
            ENCODER="h264_rkmpp"
        else
            FFMPEG="/usr/bin/ffmpeg"
            ENCODER="libx264"
        fi

        [[ -x "${FFMPEG}" ]] || {
            echo "ERROR: ffmpeg implementation is missing: ${FFMPEG}" >&2
            exit 1
        }

        INPUT_FORMAT="$(detect_ffmpeg_input_format "${DEVICE}")"

        args=(
            "${FFMPEG}"
            -hide_banner
            -loglevel info
            -f v4l2
        )

        [[ -n "${INPUT_FORMAT}" ]] && args+=(-input_format "${INPUT_FORMAT}")
        [[ -n "${RESOLUTION}" ]] && args+=(-video_size "${RESOLUTION}")
        [[ -n "${FRAMERATE}" ]] && args+=(-framerate "${FRAMERATE}")

        args+=(-i "${DEVICE}" -an -vf format=nv12)

        if [[ "${ENCODER}" == "h264_rkmpp" ]]; then
            args+=(
                -c:v h264_rkmpp
                -b:v "${BITRATE}k"
                -g "${GOP}"
            )
        else
            args+=(
                -c:v libx264
                -preset ultrafast
                -tune zerolatency
                -b:v "${BITRATE}k"
                -g "${GOP}"
            )
        fi

        args+=(
            -f rtsp
            -rtsp_transport tcp
            rtsp://127.0.0.1:8554/kvm
        )

        exec "${args[@]}"
        ;;

    gstreamer)
        GST="/usr/bin/gst-launch-1.0"
        [[ -x "${GST}" ]] || {
            echo "ERROR: gst-launch-1.0 is missing" >&2
            exit 1
        }

        case "${FOURCC}" in
            NV12) gst_format=NV12 ;; YUYV) gst_format=YUY2 ;;
            UYVY) gst_format=UYVY ;; BGR3) gst_format=BGR ;; RGB3) gst_format=RGB ;;
        esac
        args=("v4l2src" "device=${DEVICE}")
        caps="video/x-raw,format=${gst_format}"

        if [[ -n "${RESOLUTION}" || -n "${FRAMERATE}" ]]; then
            if [[ -n "${RESOLUTION}" ]]; then
                width="${RESOLUTION%x*}"
                height="${RESOLUTION#*x}"
                caps+=",width=${width},height=${height}"
            fi
            [[ -n "${FRAMERATE}" ]] && caps+=",framerate=${FRAMERATE}/1"
        fi
        args+=("!" "${caps}")

        if [[ "${FOURCC}" != NV12 ]]; then
            converter=videoconvert
            # Validated Rockchip V4L2 RGA path for RGB capture. Other hosts retain
            # software conversion; do not infer working RGA from a plugin alone.
            if [[ "${PROVIDER}" == rk3588-synopsys-hdmirx && "${FOURCC}" =~ ^(BGR3|RGB3)$ ]]; then
                inspect="$(gst-inspect-1.0 v4l2convert 2>/dev/null || true)"
                if [[ "${inspect}" == *"format:"*"NV12"* ]] &&
                   grep -qs "^rockchip-rga$" /sys/class/video4linux/video*/name; then
                    converter=v4l2convert
                fi
            fi
            args+=("!" "${converter}" "!" "video/x-raw,format=NV12")
        fi

        if [[ "${PROVIDER}" == "rk3588-synopsys-hdmirx" ]]; then
            gst-inspect-1.0 mpph264enc >/dev/null 2>&1 || {
                echo "ERROR: Rockchip GStreamer mpph264enc is unavailable" >&2
                exit 1
            }

            inspect="$(gst-inspect-1.0 mpph264enc 2>/dev/null)"
            printf '%s\n' "${inspect}" |
                grep -Eq '^[[:space:]]+bps[[:space:]]' || {
                    echo "ERROR: mpph264enc lacks the expected bps property" >&2
                    exit 1
                }
            printf '%s\n' "${inspect}" |
                grep -Eq '^[[:space:]]+gop[[:space:]]' || {
                    echo "ERROR: mpph264enc lacks the expected gop property" >&2
                    exit 1
                }

            args+=(
                "!" "mpph264enc"
                "bps=$((BITRATE * 1000))"
                "gop=${GOP}"
            )
        else
            gst-inspect-1.0 x264enc >/dev/null 2>&1 || {
                echo "ERROR: generic GStreamer x264enc is unavailable" >&2
                exit 1
            }
            args+=(
                "!" "x264enc"
                "tune=zerolatency"
                "speed-preset=ultrafast"
                "bitrate=${BITRATE}"
                "key-int-max=${GOP}"
            )
        fi

        gst-inspect-1.0 rtspclientsink >/dev/null 2>&1 || {
            echo "ERROR: GStreamer rtspclientsink is unavailable" >&2
            exit 1
        }

        args+=(
            "!" "h264parse" "config-interval=-1"
            "!" "rtspclientsink"
            "location=rtsp://127.0.0.1:8554/kvm"
            "protocols=tcp"
        )

        exec "${GST}" -e "${args[@]}"
        ;;

    *)
        echo "ERROR: unsupported backend: ${BACKEND}" >&2
        exit 1
        ;;
esac
