[Unit]
Description=Locally installed Tailscale daemon for VyOS ARM64
Documentation=https://tailscale.com/docs/install/linux
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/config/tailscale/bin/tailscaled

[Service]
Type=notify
RuntimeDirectory=tailscale
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/install -d -m 0700 /config/tailscale/state
ExecStart=/config/tailscale/bin/tailscaled --state=/config/tailscale/state/tailscaled.state --socket=/run/tailscale/tailscaled.sock
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
