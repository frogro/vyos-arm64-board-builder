# Raspberry Pi firmware needs a FAT partition visible to the boot EEPROM.
# The official VyOS EFI and persistence filesystems remain GPT2 and GPT3.

FIRMWARE_LAYOUT_MODE=raspberrypi-native-fat
FIRMWARE_PART_START=2048
FIRMWARE_PART_SECTORS=1048576
FIRMWARE_PART_TYPE=0700
FIRMWARE_PART_NAME=RPICFG
EFI_START_SECTOR=$((FIRMWARE_PART_START + FIRMWARE_PART_SECTORS))

# The source VyOS raw image starts its EFI filesystem near the beginning of the
# disk.  Grow the output by the inserted 512 MiB firmware partition.
OUTPUT_EXTRA_SECTORS=1048576

unset FIRMWARE_SKIP_SECTORS || true
