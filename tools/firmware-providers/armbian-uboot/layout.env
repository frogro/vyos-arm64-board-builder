#
# Armbian already owns the board/family-specific raw boot area via
# its evaluated OFFSET variable.
#
# Keep GPT partition 1 as the reserved firmware slot so the copied
# VyOS EFI and persistence filesystems stay GPT2/GPT3.
#

: "${ARMBIAN_OFFSET_MIB:?ARMBIAN_OFFSET_MIB missing from boot manifest}"

if ! [[ "$ARMBIAN_OFFSET_MIB" =~ ^[0-9]+$ ]]; then
    echo "ERROR: invalid ARMBIAN_OFFSET_MIB: $ARMBIAN_OFFSET_MIB" >&2
    exit 1
fi

FIRMWARE_LAYOUT_MODE=armbian-offset

SECTOR_SIZE=512
FIRMWARE_PART_START=2048

EFI_START_SECTOR=$((ARMBIAN_OFFSET_MIB * 1024 * 1024 / SECTOR_SIZE))

if (( EFI_START_SECTOR <= FIRMWARE_PART_START )); then
    echo "ERROR: Armbian OFFSET leaves no firmware partition space" >&2
    exit 1
fi

FIRMWARE_PART_SECTORS=$((EFI_START_SECTOR - FIRMWARE_PART_START))

unset FIRMWARE_SKIP_SECTORS || true
