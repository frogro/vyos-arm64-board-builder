# Build native ARM64 against the same Debian generation as the tested F runtime.
ARG BASE_IMAGE
FROM docker.io/library/debian:trixie-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git build-essential cmake ninja-build meson pkg-config libssl-dev libplist-dev libavahi-compat-libdnssd-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libgudev-1.0-dev libsystemd-dev libudev-dev libreadline-dev libglib2.0-dev libegl-dev libgl-dev libopus-dev libsdl2-dev libsdl2-ttf-dev libavcodec-dev libavformat-dev libswscale-dev libva-dev libvdpau-dev libxkbcommon-dev wayland-protocols libdrm-dev qt6-base-dev qt6-declarative-dev libqt6svg6-dev qt6-tools-dev-tools && rm -rf /var/lib/apt/lists/*
RUN git init /src/uxplay && cd /src/uxplay && git remote add origin https://github.com/FDH2/UxPlay.git && git fetch --depth=1 origin 8f40118b1a72d7e16ce684b0f3ce6a0ae32bdc79 && git checkout --detach FETCH_HEAD && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j2 && install -D build/uxplay /out/usr/local/bin/uxplay
RUN git init /src/miraclecast && cd /src/miraclecast && git remote add origin https://github.com/albfan/miraclecast.git && git fetch --depth=1 origin 0b7f1f1f6586dc65ff480f3cda5c2170a70aa020 && git checkout --detach FETCH_HEAD && meson setup build --prefix=/usr -Dbuild-tests=false && meson compile -C build -j2 && DESTDIR=/out meson install -C build
RUN git init /src/moonlight && cd /src/moonlight && git remote add origin https://github.com/moonlight-stream/moonlight-qt.git && git fetch --depth=1 origin 8369d1a0e11b999d4d1598f62ca5f6dea49602fb && git checkout --detach FETCH_HEAD && git submodule update --init --recursive --depth=1 && qmake6 moonlight-qt.pro 'CONFIG+=release' 'CONFIG+=disable-prebuilts' && make -j2 && install -D app/moonlight /out/usr/local/bin/moonlight
FROM build AS gst-crop-build
COPY experiments/profile-g/container/gstreamer-crop/ /tmp/gstreamer-crop/
COPY experiments/profile-g/container/build-gstreamer-crop.sh /tmp/build-gstreamer-crop.sh
RUN bash /tmp/build-gstreamer-crop.sh
FROM build AS request-build
COPY experiments/profile-g/container/build-ffmpeg-request.sh /tmp/build-ffmpeg-request.sh
COPY experiments/profile-g/container/ffmpeg-rps/ /tmp/ffmpeg-rps/
RUN bash /tmp/build-ffmpeg-request.sh
COPY experiments/profile-g/container/steamlink/ /tmp/steamlink/
COPY experiments/profile-g/container/build-steamlink.sh /tmp/build-steamlink.sh
RUN bash /tmp/build-steamlink.sh
FROM ${BASE_IMAGE}
USER root
RUN test "$(. /etc/os-release; echo "$VERSION_CODENAME")" = trixie && apt-get update && apt-get install -y --no-install-recommends avahi-daemon libavahi-compat-libdnssd1 libplist-2.0-4 python3-gi gir1.2-gstreamer-1.0 gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-libav gstreamer1.0-gl dbus dbus-bin iproute2 iw wpasupplicant libreadline8t64 libglib2.0-0t64 libsystemd0 libudev1 libopus0 libsdl2-2.0-0 libsdl2-ttf-2.0-0 libavcodec61 libavformat61 libswscale8 libva2 libva-drm2 libva-wayland2 libva-x11-2 libvdpau1 qt6-wayland qml6-module-qtquick-controls qml6-module-qtquick-templates qml6-module-qtquick-layouts qml6-module-qtqml-workerscript qml6-module-qtquick-window qml6-module-qtquick qml6-module-qtquick-dialogs libqt6svg6 pulseaudio seatd util-linux xwayland libxcb-xinerama0 libxcb-xinput0 libxcb-cursor0 libmd4c0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libxkbcommon-x11-0 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /
# Match the plugin ABI exactly; a distro GStreamer upgrade requires revalidation.
RUN gst-inspect-1.0 --version | grep -x "GStreamer 1.26.2"
COPY --from=gst-crop-build /gst-crop-out/ /
COPY --from=request-build /request-out/ /
COPY --from=request-build /steam-out/ /
COPY experiments/profile-g/container/*.py /opt/profile-g/
COPY experiments/profile-g/cli/receiver.py /opt/profile-g/receiver.py
# Reuse the tested rotation mapping and audio lifecycle without modifying F.
COPY experiments/kiosk-f/container/kiosk-wayland.py experiments/kiosk-f/container/kiosk-audio.py /opt/profile-g/
RUN chmod 755 /opt/profile-g/*.py && id kiosk && test -x /usr/bin/weston && uxplay -h >/dev/null && miracle-sinkctl --help >/dev/null && QT_QPA_PLATFORM=offscreen moonlight --help >/dev/null && gst-inspect-1.0 waylandsink >/dev/null
LABEL io.vyarm.receiver.version="1" io.vyarm.receiver.methods="airplay,moonlight,miracast-experimental,steamlink-experimental"
ENTRYPOINT ["python3", "/opt/profile-g/session.py"]
