[Unit]
Description=Import the versioned offline VyARM receiver runtime
Wants=vyos-arm64-grow-persistence.service
After=local-fs.target vyos-arm64-grow-persistence.service vyarm-kiosk-runtime.service
Before=vyos-router.service
ConditionPathExists=/usr/share/vyos-arm64-board-builder/receiver-runtime/runtime.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/vyos/vyarm-receiver-runtime-import
TimeoutStartSec=300
RemainAfterExit=yes

[Install]
WantedBy=vyos.target
