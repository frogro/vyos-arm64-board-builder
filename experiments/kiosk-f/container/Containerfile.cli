# Live-test layer; preserve the previously validated encoder image as rollback.
FROM localhost/vyarm-kiosk:mpp-test
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xinput && rm -rf /var/lib/apt/lists/*
COPY kiosk-display.py kiosk-session.py /usr/local/bin/
RUN chmod 755 /usr/local/bin/kiosk-display.py /usr/local/bin/kiosk-session.py
