# Live-test layer; preserve the previously validated encoder image as rollback.
FROM localhost/vyarm-kiosk:mpp-test
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xinput && rm -rf /var/lib/apt/lists/*
COPY kiosk-audio.py kiosk-display.py kiosk-session.py kiosk-media.py kiosk-sunshine.py kiosk-graphics.py start-kiosk /usr/local/bin/
RUN chmod 755 /usr/local/bin/start-kiosk /usr/local/bin/kiosk-display.py /usr/local/bin/kiosk-session.py /usr/local/bin/kiosk-sunshine.py
LABEL io.vyarm.kiosk.sunshine-policy="1"
LABEL io.vyarm.kiosk.sunshine-origins="1"

LABEL io.vyarm.kiosk.media-policy="2"
