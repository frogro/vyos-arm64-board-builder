#!/bin/bash
set -euo pipefail
if [ "${KIOSK_SESSION_READY:-0}" != 1 ]; then
    export KIOSK_SESSION_READY=1
    exec setsid --wait /bin/bash -c 'exec /usr/local/bin/start-kiosk </dev/tty8'
fi
export DISPLAY=:0 XAUTHORITY=/run/kiosk/Xauthority
# Only an explicitly passed-through encoder device is adjusted. Sunshine still
# runs as kiosk; neither world access nor a privileged container is required.
if [ -c /dev/mpp_service ]; then
    chgrp video /dev/mpp_service
    chmod 0660 /dev/mpp_service
fi
mkdir -p /run/kiosk /state/browser /state/sunshine
# This profile belongs exclusively to this kiosk instance.
exec 9>/state/kiosk-session.lock
flock -n 9 || { echo "Kiosk profile already in use" >&2; exit 1; }
if pgrep -x chromium >/dev/null; then
    echo "Chromium is already running; refusing profile cleanup" >&2
    exit 1
fi
rm -f /state/browser/SingletonLock /state/browser/SingletonSocket /state/browser/SingletonCookie
chown -R kiosk:kiosk /run/kiosk /state
cookie=$(mcookie)
xauth -f "$XAUTHORITY" add :0 MIT-MAGIC-COOKIE-1 "$cookie"
chown kiosk:kiosk "$XAUTHORITY"
Xorg :0 vt8 -keeptty -nolisten tcp -auth "$XAUTHORITY" -config /etc/X11/xorg.conf -logfile /state/Xorg.log &
xpid=$!
trap 'kill "$xpid" 2>/dev/null || true' EXIT
for n in $(seq 1 40); do
    if xdpyinfo >/dev/null 2>&1; then break; fi
    kill -0 "$xpid" || { cat /state/Xorg.log; exit 1; }
    sleep 1
done
xdpyinfo >/dev/null
runuser -u kiosk -- env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" XDG_RUNTIME_DIR=/run/kiosk HOME=/home/kiosk KIOSK_URL="$KIOSK_URL" dbus-run-session -- /usr/local/bin/kiosk-session
