{
  "flags": [
    "--no-first-run",
    "--autoplay-policy=no-user-gesture-required",
    "--disable-background-networking",
    "--user-data-dir=/tmp/probe-profile",
    "--remote-debugging-pipe",
    "--enable-logging=stderr",
    "--enable-gpu",
    "--use-gl=angle",
    "--use-angle=gles",
    "--enable-features=AcceleratedVideoDecoder,AcceleratedVideoDecodeLinuxGL,PreferV4L2VideoAcceleration,NativePixmapAccurateYuvMatrix,V4L2ExtraCaptureBuffers,V4L2ExtraAV1CaptureBuffers",
    "--ozone-platform=wayland",
    "--start-fullscreen",
    "--window-size=1920,1080",
    "--disable-accelerated-video-decode"
  ]
}
