+// P010 has two 16-bit color planes in a single V4L2 buffer. Preserve
+// driver-provided byte stride, including row padding, for the UV offset.
+TEST(V4L2UtilsTest, V4L2FormatToVideoFrameLayoutP010) {
+  auto layout = V4L2FormatToVideoFrameLayout(V4L2FormatVideoOutputMplane(
+      300, 180, V4L2_PIX_FMT_P010, V4L2_FIELD_ANY, {640}, {172800}));
+  ASSERT_TRUE(layout.has_value());
+  EXPECT_EQ(PIXEL_FORMAT_P010LE, layout->format());
+  EXPECT_EQ(gfx::Size(300, 180), layout->coded_size());
+  std::vector<ColorPlaneLayout> expected_planes(
+      {{640, 0u, 172800u}, {640, 115200u, 57600u}});
+  EXPECT_EQ(expected_planes, layout->planes());
+  EXPECT_FALSE(layout->is_multi_planar());
+}
