+/* Diagnostic only: bit 0/1 core, bit 2/3 BIU; -1 retains normal handling. */
+static int vyarm_test_remove_reset_mask = -1;
+module_param(vyarm_test_remove_reset_mask, int, 0444);
+MODULE_PARM_DESC(vyarm_test_remove_reset_mask,
+                "TEST ONLY: RK3588 AV1 remove reset mask, -1 normal, 0..15 split");
+
+static int vyarm_test_reset(struct hantro_dev *vpu, bool assert, unsigned int mask)
+{
+	int i, ret;
+
+	if (!vpu->vyarm_test_split_resets)
+		return assert ? reset_control_assert(vpu->resets) :
+				reset_control_deassert(vpu->resets);
+	for (i = 0; i < 4; i++) {
+		if (!(mask & BIT(i)))
+			continue;
+		ret = assert ? reset_control_assert(vpu->vyarm_test_resets[i]) :
+			       reset_control_deassert(vpu->vyarm_test_resets[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
 
