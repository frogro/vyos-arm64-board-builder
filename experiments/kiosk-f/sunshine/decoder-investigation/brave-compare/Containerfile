FROM localhost/vyarm-kiosk:weston16-test3
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg && echo 'deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main' > /etc/apt/sources.list.d/brave.list && apt-get update && apt-get install -y --no-install-recommends brave-browser
