+// Experimental Chromium 153 stateless HEVC SPS RPS support.
+#ifndef MEDIA_GPU_V4L2_V4L2_HEVC_SPS_RPS_H_
+#define MEDIA_GPU_V4L2_V4L2_HEVC_SPS_RPS_H_
+#include <linux/v4l2-controls.h>
+#include <array>
+#include <cstdint>
+#include <iterator>
+#ifndef V4L2_CID_STATELESS_HEVC_EXT_SPS_ST_RPS
+#define V4L2_CID_STATELESS_HEVC_EXT_SPS_ST_RPS (V4L2_CID_CODEC_STATELESS_BASE + 408)
+#define V4L2_HEVC_EXT_SPS_ST_RPS_FLAG_INTER_REF_PIC_SET_PRED 0x1
+struct v4l2_ctrl_hevc_ext_sps_st_rps {
+  __u8 delta_idx_minus1, delta_rps_sign, num_negative_pics, num_positive_pics;
+  __u32 used_by_curr_pic, use_delta_flag;
+  __u16 abs_delta_rps_minus1;
+  __u16 delta_poc_s0_minus1[16], delta_poc_s1_minus1[16];
+  __u16 flags;
+};
+#endif
+#ifndef V4L2_CID_STATELESS_HEVC_EXT_SPS_LT_RPS
+#define V4L2_CID_STATELESS_HEVC_EXT_SPS_LT_RPS (V4L2_CID_CODEC_STATELESS_BASE + 409)
+#define V4L2_HEVC_EXT_SPS_LT_RPS_FLAG_USED_LT 0x1
+struct v4l2_ctrl_hevc_ext_sps_lt_rps {
+  __u16 lt_ref_pic_poc_lsb_sps, flags;
+};
+#endif
+namespace media {
+// Templated to allow the pure conversion to be exercised without a browser build.
+template <typename Rps>
+bool FillHevcShortTermRps(const Rps& in,
+                          v4l2_ctrl_hevc_ext_sps_st_rps& out) {
+  out = {};
+  if (in.num_negative_pics < 0 || in.num_positive_pics < 0 ||
+      in.num_negative_pics + in.num_positive_pics > 16 ||
+      in.delta_idx_minus1 < 0 || in.delta_idx_minus1 > 255 ||
+      in.delta_rps_sign < 0 || in.delta_rps_sign > 1 ||
+      in.abs_delta_rps_minus1 < 0 || in.abs_delta_rps_minus1 > 32767)
+    return false;
+  out.delta_idx_minus1 = in.delta_idx_minus1;
+  out.delta_rps_sign = in.delta_rps_sign;
+  out.abs_delta_rps_minus1 = in.abs_delta_rps_minus1;
+  out.num_negative_pics = in.num_negative_pics;
+  out.num_positive_pics = in.num_positive_pics;
+  if (in.inter_ref_pic_set_prediction_flag) {
+    out.flags = V4L2_HEVC_EXT_SPS_ST_RPS_FLAG_INTER_REF_PIC_SET_PRED;
+    for (size_t j = 0; j < in.used_by_curr_pic_flag.size(); ++j) {
+      if (j >= 32) {
+        if (in.used_by_curr_pic_flag[j] || in.use_delta_flag[j])
+          return false;
+      } else {
+        out.used_by_curr_pic |= uint32_t(in.used_by_curr_pic_flag[j]) << j;
+        out.use_delta_flag |= uint32_t(in.use_delta_flag[j]) << j;
+      }
+    }
+  } else {
+    for (int j = 0; j < in.num_negative_pics; ++j) {
+      if (in.delta_poc_s0_minus1[j] < 0 || in.delta_poc_s0_minus1[j] > 32767)
+        return false;
+      out.delta_poc_s0_minus1[j] = in.delta_poc_s0_minus1[j];
+      out.used_by_curr_pic |= uint32_t(!!in.used_by_curr_pic_s0[j]) << j;
+    }
+    for (int j = 0; j < in.num_positive_pics; ++j) {
+      if (in.delta_poc_s1_minus1[j] < 0 || in.delta_poc_s1_minus1[j] > 32767)
+        return false;
+      out.delta_poc_s1_minus1[j] = in.delta_poc_s1_minus1[j];
+      out.used_by_curr_pic |= uint32_t(!!in.used_by_curr_pic_s1[j])
+                             << (in.num_negative_pics + j);
+    }
+  }
+  return true;
+}
+}  // namespace media
+#endif
