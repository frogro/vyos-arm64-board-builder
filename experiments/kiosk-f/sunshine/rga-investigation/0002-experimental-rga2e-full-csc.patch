+/* Experimental: full-range RGB -> NV12 only on verified RGA2E revision. */
+static bool rga_test_rgb_full_csc(struct rga_ctx *ctx)
+{
+	struct rockchip_rga *rga = ctx->rga;
+	static const s32 coeff[4][3][4] = {
+		{ { 263, 516, 100, 16384 }, { -152, -298, 450, 131072 }, { 450, -377, -73, 131072 } },
+		{ { 306, 601, 117, 0 }, { -173, -339, 512, 131072 }, { 512, -429, -83, 131072 } },
+		{ { 187, 629, 63, 16384 }, { -103, -347, 450, 131072 }, { 450, -409, -41, 131072 } },
+		{ { 218, 732, 74, 0 }, { -117, -395, 512, 131072 }, { 512, -465, -47, 131072 } },
+	};
+	unsigned int row, col, matrix;
+	bool full;
+	u32 value;
+
+	if (ctx->in.fmt->fourcc != V4L2_PIX_FMT_XBGR32 ||
+	    ctx->out.fmt->fourcc != V4L2_PIX_FMT_NV12 ||
+	    ctx->in.pix.quantization != V4L2_QUANTIZATION_FULL_RANGE ||
+	    (ctx->out.colorspace != V4L2_COLORSPACE_REC709 &&
+	     ctx->out.colorspace != V4L2_COLORSPACE_SMPTE170M) ||
+	    (ctx->out.pix.quantization != V4L2_QUANTIZATION_LIM_RANGE &&
+	     ctx->out.pix.quantization != V4L2_QUANTIZATION_FULL_RANGE) ||
+	    rga_read(rga, RGA_VERSION_INFO) != 0x03263318)
+		return false;
+	full = ctx->out.pix.quantization == V4L2_QUANTIZATION_FULL_RANGE;
+	matrix = (ctx->out.colorspace == V4L2_COLORSPACE_REC709 ? 2 : 0) + full;
+	for (row = 0; row < 3; row++) {
+		for (col = 0; col < 4; col++) {
+			value = coeff[matrix][row][col] & (col == 3 ? 0x1fffff : 0x1fff);
+			if (row == 0 && col == 0)
+				value |= ((full ? 255 : 235) << 16) | ((full ? 0 : 16) << 24);
+			if (row == 0 && col == 1)
+				value |= ((full ? 255 : 240) << 16) | ((full ? 0 : 16) << 24);
+			rga_write(rga, 0x060 + row * 16 + col * 4, value);
+		}
+	}
+	return true;
+}
