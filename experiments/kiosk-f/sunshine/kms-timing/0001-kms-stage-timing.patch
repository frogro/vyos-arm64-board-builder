--- a/src/platform/linux/kmsgrab.cpp
+++ b/src/platform/linux/kmsgrab.cpp
@@ -3,6 +3,8 @@
  * @brief Definitions for KMS screen capture.
  */
 // standard includes
+#include <array>
+#include <cstdlib>
 #include <errno.h>
 #include <fcntl.h>
 #include <filesystem>
@@ -1780,6 +1782,9 @@
        * @return Capture status reported to the streaming pipeline.
        */
       capture_e snapshot(const pull_free_image_cb_t &pull_free_image_cb, std::shared_ptr<platf::img_t> &img_out, std::chrono::milliseconds timeout, bool cursor) {
+        // Opt-in diagnostic only; report aggregates to avoid per-frame logging.
+        static const bool timing = std::getenv("SUNSHINE_VYARM_KMS_TIMING") != nullptr;
+        const auto t0 = timing ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point {};
         file_t fb_fd[4];
 
         egl::surface_descriptor_t sd;
@@ -1790,12 +1795,14 @@
           return status;
         }
 
+        const auto t1 = timing ? std::chrono::steady_clock::now() : t0;
         auto rgb_opt = egl::import_source(display.get(), sd);
 
         if (!rgb_opt) {
           return capture_e::error;
         }
 
+        const auto t2 = timing ? std::chrono::steady_clock::now() : t0;
         auto &rgb = *rgb_opt;
 
         gl::ctx.BindTexture(GL_TEXTURE_2D, rgb->tex[0]);
@@ -1811,14 +1818,41 @@
           return platf::capture_e::interrupted;
         }
 
+        const auto t3 = timing ? std::chrono::steady_clock::now() : t0;
         gl::ctx.GetTextureSubImage(rgb->tex[0], 0, img_offset_x, img_offset_y, 0, width, height, 1, GL_BGRA, GL_UNSIGNED_BYTE, img_out->height * img_out->row_pitch, img_out->data);
 
+        const auto t4 = timing ? std::chrono::steady_clock::now() : t0;
         img_out->frame_timestamp = frame_timestamp;
 
         if (cursor && captured_cursor.visible) {
           blend_cursor(*img_out);
         }
 
+        if (timing) {
+          const auto t5 = std::chrono::steady_clock::now();
+          static thread_local std::array<double, 6> sums {};
+          static thread_local unsigned samples = 0;
+          const std::array<double, 6> values {
+            std::chrono::duration<double, std::milli>(t1-t0).count(),
+            std::chrono::duration<double, std::milli>(t2-t1).count(),
+            std::chrono::duration<double, std::milli>(t3-t2).count(),
+            std::chrono::duration<double, std::milli>(t4-t3).count(),
+            std::chrono::duration<double, std::milli>(t5-t4).count(),
+            std::chrono::duration<double, std::milli>(t5-t0).count()
+          };
+          for (unsigned i = 0; i < sums.size(); ++i) {
+            sums[i] += values[i];
+          }
+          if (++samples == 60) {
+            BOOST_LOG(info) << "VYARM_KMS_TIMING frames=" << samples
+              << " refresh_ms=" << sums[0]/samples << " import_ms=" << sums[1]/samples
+              << " prepare_ms=" << sums[2]/samples << " readback_ms=" << sums[3]/samples
+              << " cursor_ms=" << sums[4]/samples << " total_ms=" << sums[5]/samples
+              << " width=" << width << " height=" << height;
+            sums.fill(0.0);
+            samples = 0;
+          }
+        }
         return capture_e::ok;
       }
 
