FROM docker.io/library/debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
 ca-certificates git build-essential cmake ninja-build pkg-config python3 python3-jinja2 \
 libcap-dev libcurl4-openssl-dev libdrm-dev libevdev-dev libgbm-dev \
 libminiupnpc-dev libnuma-dev libopus-dev libpulse-dev libssl-dev libsystemd-dev \
 libudev-dev libwayland-dev libx11-dev libxcb-shm0-dev libxcb-xfixes0-dev libxcb1-dev \
 libxfixes-dev libxrandr-dev libxtst-dev libva-dev libx264-dev libx265-dev \
 libvulkan-dev libpipewire-0.3-dev npm patch curl xz-utils && rm -rf /var/lib/apt/lists/*
COPY *.patch /tmp/
WORKDIR /build
RUN git init mpp && cd mpp && git remote add origin https://github.com/rockchip-linux/mpp.git \
 && git fetch --depth 1 origin c08762ebfadeb4e986d2fed993bc7a54862d3ebe \
 && git checkout --detach FETCH_HEAD \
 && patch --batch --fuzz=0 -p1 < /tmp/0002-mpp-container-compatible-path.patch \
 && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/mpp -DBUILD_SHARED_LIBS=ON -DBUILD_TEST=OFF \
 && cmake --build build -j2 && cmake --install build
RUN git init ffmpeg && cd ffmpeg && git remote add origin https://github.com/nyanmisaka/ffmpeg-rockchip.git \
 && git fetch --depth 1 origin d90e3a1c18d7929383cf88c1b3da2e2d1c966cbf && git checkout --detach FETCH_HEAD
ENV PKG_CONFIG_PATH=/opt/mpp/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/mpp/lib
RUN cd ffmpeg && patch --batch --fuzz=0 -p1 < /tmp/0003-experimental-single-eos.patch \
 && patch --batch --fuzz=0 -p1 < /tmp/0004-experimental-frame-ownership.patch \
 && ./configure --prefix=/opt/ffmpeg --disable-all --disable-autodetect \
 --disable-programs --disable-doc --enable-gpl --enable-version3 --enable-static --disable-shared --enable-pic \
 --enable-avcodec --enable-avutil --enable-swscale --enable-bsfs \
 --enable-libdrm --enable-rkmpp --enable-libx264 --enable-libx265 --enable-vaapi \
 --enable-encoder=h264_rkmpp,hevc_rkmpp,libx264,libx265,h264_vaapi,hevc_vaapi \
 && make -j2 && make install \
 && cp -a libavcodec/*.h /opt/ffmpeg/include/libavcodec/ \
 && cp -a libavcodec/hevc /opt/ffmpeg/include/libavcodec/ \
 && cp -a libavutil/*.h /opt/ffmpeg/include/libavutil/ \
 && cp config.h /opt/ffmpeg/include/ \
 && mkdir -p /opt/ffmpeg/include/libavutil/aarch64 \
 && cp libavutil/aarch64/*.h /opt/ffmpeg/include/libavutil/aarch64/ \
 && cp -a libavutil/arm /opt/ffmpeg/include/libavutil/ \
 && ar rcs /opt/ffmpeg/lib/libcbs.a

ADD sunshine-source.tar.gz /build/
ENV BUILD_VERSION=2026.914.233613-vyarm-mpp-test BRANCH=experimental-mpp COMMIT=63d35f702ee9e362e43263742981836ec0710384
COPY rga-converter.hpp /build/source/src/platform/linux/rga-converter.hpp
RUN cd /build/source && patch --batch --fuzz=0 -p1 < /tmp/0002-enable-hevc-mpp.patch \
 && patch --batch --fuzz=0 -p1 < /tmp/0001-opt-in-sunshine-converter.patch \
 && patch --batch --fuzz=0 -p1 < /tmp/0001-kms-stage-timing.patch \
 && cmake -S /build/source -B /cmake-build-kms-timing -G Ninja \
 -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
 -DSUNSHINE_ASSETS_DIR=share/sunshine \
 -DSUNSHINE_PUBLISHER_NAME=VyARM-Experimental \
 -DBUILD_DOCS=OFF -DBUILD_TESTS=OFF -DSUNSHINE_ENABLE_TRAY=OFF \
 -DSUNSHINE_ENABLE_CUDA=OFF -DSUNSHINE_ENABLE_VULKAN=OFF \
 -DSUNSHINE_ENABLE_WAYLAND=OFF -DSUNSHINE_ENABLE_KWIN=OFF \
 -DSUNSHINE_ENABLE_PORTAL=OFF -DSUNSHINE_ENABLE_X11=ON \
 -DSUNSHINE_ENABLE_DRM=ON -DFFMPEG_PREPARED_BINARIES=/opt/ffmpeg \
 '-DFFMPEG_PLATFORM_LIBRARIES=x264;x265;/opt/mpp/lib/librockchip_mpp.so;drm;numa;va;va-drm;va-x11;X11;m;pthread;dl;rt' \
 && cmake --build /cmake-build-kms-timing --target sunshine -j1 \
 && mkdir -p /build/sunshine-build \
 && cp /cmake-build-kms-timing/sunshine /build/sunshine-build/sunshine
