FROM docker.io/library/debian:bookworm-slim
LABEL io.vyarm.print.version="1"
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cups cups-client cups-ipp-utils python3-cups dbus avahi-daemon printer-driver-gutenprint ca-certificates openssl && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/cups-defaults && cp -a /etc/cups/. /opt/cups-defaults/ && useradd --system --no-create-home --groups lpadmin --shell /usr/sbin/nologin vyos
COPY resume-usb-jobs.py /usr/local/sbin/resume-usb-jobs.py
COPY entrypoint /usr/local/sbin/print-entrypoint
ENTRYPOINT ["/usr/local/sbin/print-entrypoint"]
