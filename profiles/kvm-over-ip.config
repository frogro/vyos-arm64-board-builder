# Optional generic KVM-over-IP kernel capabilities.
# Applied only when KVM_OVER_IP=yes. Board-specific UDC availability is a
# runtime hardware property and is deliberately not assumed here.

CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_PCI_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_SND_USB_AUDIO=m
# Built-in gadget core is required by a built-in DWC3 controller when an
# exact-board provider selects DWC3 dual-role mode.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_HID=y
