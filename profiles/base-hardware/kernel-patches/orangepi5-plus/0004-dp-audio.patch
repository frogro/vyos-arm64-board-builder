+static void dw_dp_clear_sdp(struct dw_dp *dp, int nr)
+{
+	guard(mutex)(&dp->sdp_lock);
+	regmap_clear_bits(dp->regmap, DW_DP_SDP_VERTICAL_CTRL, EN_VERTICAL_SDP << nr);
+	regmap_clear_bits(dp->regmap, DW_DP_SDP_HORIZONTAL_CTRL, EN_HORIZONTAL_SDP << nr);
+	clear_bit(nr, dp->sdp_reg_bank);
 }
 
