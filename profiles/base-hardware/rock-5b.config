# ROCK 5B base hardware; available independently of KVM applications.

CONFIG_VIDEO_SYNOPSYS_HDMIRX=m
CONFIG_VIDEO_SYNOPSYS_HDMIRX_LOAD_DEFAULT_EDID=y

# usb@fc000000 is dr_mode="otg" in the ROCK 5B Device Tree. Replace the
# stock host-only DWC3 choice for this exact board.
CONFIG_USB_DWC3=y
# CONFIG_USB_DWC3_HOST is not set
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
# RK3588 hardware H.264/H.265 encoder via Rockchip MPP / VEPU580.
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_PROC_FS=y
CONFIG_ROCKCHIP_MPP_RKVENC2=y
# CONFIG_ROCKCHIP_MPP_RKVENC2_DEVFREQ is not set
# CONFIG_ROCKCHIP_MPP_RKVDEC2 is not set

# Optional revision-gated RGB color conversion; disabled at runtime by default.
CONFIG_VIDEO_ROCKCHIP_RGA=m

# Shared DMA buffers for board GPU/video/RGA consumers in D, F and G.
# Linux 6.18 exposes these options as bool, not loadable modules.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMABUF_HEAPS_CMA=y
