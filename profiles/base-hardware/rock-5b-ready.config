CONFIG_VIDEO_SYNOPSYS_HDMIRX=available
CONFIG_VIDEO_SYNOPSYS_HDMIRX_LOAD_DEFAULT_EDID=builtin
CONFIG_USB_DWC3=builtin
CONFIG_USB_DWC3_HOST=disabled
CONFIG_USB_DWC3_DUAL_ROLE=builtin
CONFIG_USB_ROLE_SWITCH=builtin
CONFIG_ROCKCHIP_MPP_SERVICE=builtin
CONFIG_ROCKCHIP_MPP_PROC_FS=builtin
CONFIG_ROCKCHIP_MPP_RKVENC2=builtin
CONFIG_ROCKCHIP_MPP_RKVENC2_DEVFREQ=disabled
CONFIG_ROCKCHIP_MPP_RKVDEC2=disabled

# Optional revision-gated RGB color conversion; disabled at runtime by default.
CONFIG_VIDEO_ROCKCHIP_RGA=available
CONFIG_DRM_PANTHOR=available
CONFIG_VIDEO_HANTRO=available
CONFIG_VIDEO_HANTRO_ROCKCHIP=builtin
CONFIG_VIDEO_ROCKCHIP_VDEC=available
CONFIG_SRAM=builtin
CONFIG_INPUT_UINPUT=available
CONFIG_HID_MULTITOUCH=available
CONFIG_CPU_THERMAL=builtin
CONFIG_DEVFREQ_THERMAL=builtin
CONFIG_ENERGY_MODEL=builtin

# Validate the generated kernel, independent of enabled applications.
CONFIG_DMABUF_HEAPS=builtin
CONFIG_DMABUF_HEAPS_SYSTEM=builtin
CONFIG_CMA=builtin
CONFIG_DMA_CMA=builtin
CONFIG_DMABUF_HEAPS_CMA=builtin
