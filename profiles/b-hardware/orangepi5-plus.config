# Exact board: live DT usb@fc000000 requests OTG + usb-role-switch.
CONFIG_USB_DWC3=y
# CONFIG_USB_DWC3_HOST is not set
# CONFIG_USB_DWC3_GADGET is not set
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_FUSB302=y
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_ROCKCHIP_DW_DP=y
CONFIG_SND_SOC_ES8328_I2C=m

# Prepared hardware support, independent of D/F/G applications.
CONFIG_DRM_PANTHOR=m
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_ROCKET=m
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_HANTRO=m
CONFIG_VIDEO_HANTRO_ROCKCHIP=y
CONFIG_VIDEO_ROCKCHIP_VDEC=m
CONFIG_VIDEO_ROCKCHIP_RGA=m
CONFIG_VIDEO_SYNOPSYS_HDMIRX=m
CONFIG_ROCKCHIP_MPP_SERVICE=m
CONFIG_ROCKCHIP_MPP_PROC_FS=y
CONFIG_ROCKCHIP_MPP_RKVENC2=y
# Use upstream V4L2 rkvdec; do not register a competing MPP decoder.
# CONFIG_ROCKCHIP_MPP_RKVDEC2 is not set
# CONFIG_ROCKCHIP_MPP_RKVENC2_DEVFREQ is not set
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_TC358743=m
CONFIG_VIDEO_IMX219=m
CONFIG_VIDEO_IMX296=m
CONFIG_VIDEO_OV5647=m
CONFIG_ROCKCHIP_DW_MIPI_DSI2=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=m
CONFIG_DRM_PANEL_SIMPLE=m
CONFIG_DRM_PANEL_EDP=m
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_LIRC=y

# Cooling registration is required even when multimedia applications are absent.
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_ENERGY_MODEL=y
# Select visible ConfigFS functions; Kconfig derives the USB_F_* modules.
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_USB_CONFIGFS_F_UAC2=y
