<?xml version="1.0"?>
<interfaceDefinition>
  <node name="service">
    <properties>
      <help>System services</help>
    </properties>
    <children>
      <node name="kvm-over-ip" owner="/usr/libexec/vyos/conf_mode/service_kvm_over_ip.py">
        <properties>
          <help>KVM-over-IP service</help>
          <priority>1000</priority>
        </properties>
        <children>
          <node name="video">
            <properties>
              <help>Video capture and streaming</help>
            </properties>
            <children>
              <leafNode name="backend">
                <properties>
                  <help>Video streaming backend</help>
                  <completionHelp>
                    <list>ustreamer gstreamer ffmpeg</list>
                  </completionHelp>
                  <constraint>
                    <regex>(ustreamer|gstreamer|ffmpeg)</regex>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="device">
                <properties>
                  <help>Override V4L2 capture device</help>
                  <constraint>
                    <regex>/dev/video[0-9]+</regex>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="resolution">
                <properties>
                  <help>Requested capture resolution</help>
                  <constraint>
                    <regex>[0-9]{2,5}x[0-9]{2,5}</regex>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="framerate">
                <properties>
                  <help>Requested capture frame rate</help>
                  <constraint>
                    <validator name="numeric" argument="--range 1-240"/>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="bitrate">
                <properties>
                  <help>H.264 target bitrate in kbit/s</help>
                  <constraint>
                    <validator name="numeric" argument="--range 250-100000"/>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="gop">
                <properties>
                  <help>H.264 GOP length in frames</help>
                  <constraint>
                    <validator name="numeric" argument="--range 1-600"/>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="listen-address">
                <properties>
                  <help>Browser-facing stream listen address</help>
                  <constraint>
                    <validator name="ipv4-address"/>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="port">
                <properties>
                  <help>Browser-facing stream port</help>
                  <constraint>
                    <validator name="numeric" argument="--range 1-65535"/>
                  </constraint>
                </properties>
              </leafNode>
            </children>
          </node>

          <leafNode name="keyboard">
            <properties>
              <help>Enable USB HID keyboard</help>
              <valueless/>
            </properties>
          </leafNode>

          <node name="mouse">
            <properties>
              <help>USB HID mouse functions</help>
            </properties>
            <children>
              <leafNode name="absolute">
                <properties>
                  <help>Enable absolute USB HID mouse</help>
                  <valueless/>
                </properties>
              </leafNode>
              <leafNode name="relative">
                <properties>
                  <help>Enable relative USB HID mouse</help>
                  <valueless/>
                </properties>
              </leafNode>
            </children>
          </node>

          <node name="usb">
            <properties>
              <help>USB gadget routing</help>
            </properties>
            <children>
              <leafNode name="port">
                <properties>
                  <help>Provider-defined semantic USB gadget port</help>
                  <constraint>
                    <regex>[a-z0-9]+([_-][a-z0-9]+)*</regex>
                  </constraint>
                </properties>
              </leafNode>
            </children>
          </node>

          <node name="virtual-media">
            <properties>
              <help>USB read-only CD-ROM virtual media</help>
            </properties>
            <children>
              <leafNode name="file">
                <properties>
                  <help>ISO image below /config/kvm-over-ip/media</help>
                  <constraint>
                    <regex>/config/kvm-over-ip/media/.+\.iso</regex>
                  </constraint>
                </properties>
              </leafNode>
            </children>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
