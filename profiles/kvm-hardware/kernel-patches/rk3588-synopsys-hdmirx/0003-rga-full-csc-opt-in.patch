From: VyARM experimental media integration
Subject: [PATCH] media: rga: opt-in revision-gated RGB full CSC

Consolidated from the live-tested full-CSC/NV12M candidate. Disabled by
default; keep legacy CSC selection when disabled or unsupported. Applies
only through the KVM hardware provider. No board-name check in the driver.

--- a/drivers/media/platform/rockchip/rga/rga-hw.c
+++ b/drivers/media/platform/rockchip/rga/rga-hw.c
@@ -5,6 +5,11 @@
  */
 
 #include <linux/pm_runtime.h>
+#include <linux/moduleparam.h>
+
+static bool experimental_full_csc;
+module_param(experimental_full_csc, bool, 0644);
+MODULE_PARM_DESC(experimental_full_csc, "Enable tested revision-gated RGB full-CSC experiment");
 
 #include "rga-hw.h"
 #include "rga.h"
@@ -150,6 +155,50 @@
 	dest[reg >> 2] |= 0x7 << 8;
 }
 
+/* Experimental: full-range RGB -> NV12 only on verified RGA2E revision. */
+static bool rga_test_rgb_full_csc(struct rga_ctx *ctx)
+{
+	struct rockchip_rga *rga = ctx->rga;
+	static const s32 coeff[4][3][4] = {
+		{ { 263, 516, 100, 16384 }, { -152, -298, 450, 131072 }, { 450, -377, -73, 131072 } },
+		{ { 306, 601, 117, 0 }, { -173, -339, 512, 131072 }, { 512, -429, -83, 131072 } },
+		{ { 187, 629, 63, 16384 }, { -103, -347, 450, 131072 }, { 450, -409, -41, 131072 } },
+		{ { 218, 732, 74, 0 }, { -117, -395, 512, 131072 }, { 512, -465, -47, 131072 } },
+	};
+	unsigned int row, col, matrix;
+	bool full;
+	u32 value;
+
+	if (!experimental_full_csc)
+		return false;
+
+	if ((ctx->in.fmt->fourcc != V4L2_PIX_FMT_XBGR32 &&
+	     ctx->in.fmt->fourcc != V4L2_PIX_FMT_BGR24 &&
+	     ctx->in.fmt->fourcc != V4L2_PIX_FMT_RGB24) ||
+	    (ctx->out.fmt->fourcc != V4L2_PIX_FMT_NV12 &&
+	     ctx->out.fmt->fourcc != V4L2_PIX_FMT_NV12M) ||
+	    ctx->in.pix.quantization != V4L2_QUANTIZATION_FULL_RANGE ||
+	    (ctx->out.colorspace != V4L2_COLORSPACE_REC709 &&
+	     ctx->out.colorspace != V4L2_COLORSPACE_SMPTE170M) ||
+	    (ctx->out.pix.quantization != V4L2_QUANTIZATION_LIM_RANGE &&
+	     ctx->out.pix.quantization != V4L2_QUANTIZATION_FULL_RANGE) ||
+	    rga_read(rga, RGA_VERSION_INFO) != 0x03263318)
+		return false;
+	full = ctx->out.pix.quantization == V4L2_QUANTIZATION_FULL_RANGE;
+	matrix = (ctx->out.colorspace == V4L2_COLORSPACE_REC709 ? 2 : 0) + full;
+	for (row = 0; row < 3; row++) {
+		for (col = 0; col < 4; col++) {
+			value = coeff[matrix][row][col] & (col == 3 ? 0x1fffff : 0x1fff);
+			if (row == 0 && col == 0)
+				value |= ((full ? 255 : 235) << 16) | ((full ? 0 : 16) << 24);
+			if (row == 0 && col == 1)
+				value |= ((full ? 255 : 240) << 16) | ((full ? 0 : 16) << 24);
+			rga_write(rga, 0x060 + row * 16 + col * 4, value);
+		}
+	}
+	return true;
+}
+
 static void rga_cmd_set_trans_info(struct rga_ctx *ctx)
 {
 	struct rockchip_rga *rga = ctx->rga;
@@ -211,6 +260,11 @@
 			dst_info.data.csc_mode = RGA_DST_CSC_MODE_BT601_R0;
 			break;
 		}
+	}
+
+	if (rga_test_rgb_full_csc(ctx)) {
+		dst_info.data.csc_mode = 1;
+		dst_info.val |= BIT(19) | BIT(18);
 	}
 
 	if (ctx->vflip)
--- a/drivers/media/platform/rockchip/rga/rga.c
+++ b/drivers/media/platform/rockchip/rga/rga.c
@@ -477,6 +477,9 @@
 
 	pix_fmt->field = V4L2_FIELD_NONE;
 	pix_fmt->colorspace = frm->colorspace;
+	pix_fmt->quantization = frm->pix.quantization;
+	pix_fmt->ycbcr_enc = frm->pix.ycbcr_enc;
+	pix_fmt->xfer_func = frm->pix.xfer_func;
 
 	return 0;
 }
