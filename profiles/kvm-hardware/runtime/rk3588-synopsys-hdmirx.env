# Runtime USB-gadget routing for the exact ROCK 5B KVM provider.
#
# The generic gadget manager must not know SoC controller addresses.  Each
# proven board/provider supplies semantic port -> UDC mappings here.
#
# USB-C with a separate PD power/data injector: keyboard and relative mouse
# verified on ROCK 5B at USB 2.0 high speed. USB-A remains a host port.
KVM_GADGET_PROVIDER=rk3588-synopsys-hdmirx
KVM_GADGET_DEFAULT_PORT=usbc
KVM_GADGET_PORTS="usbc"
KVM_GADGET_UDC_USBC=fc000000.usb
KVM_GADGET_SERIAL=ROCK5B-KVM
