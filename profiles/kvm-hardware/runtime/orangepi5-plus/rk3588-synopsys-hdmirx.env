# Orange Pi 5 Plus USB-C data/OTG connector; not the USB-C power input.
# TCPM/FUSB302 selects the device role. Do not force USB-A peripheral mode
# or apply ROCK-specific VBUS/BVALID overrides.
KVM_GADGET_PROVIDER=rk3588-synopsys-hdmirx
KVM_GADGET_DEFAULT_PORT=usbc
KVM_GADGET_PORTS="usbc"
KVM_GADGET_UDC_USBC=fc000000.usb
KVM_GADGET_SERIAL=ORANGEPI5PLUS-KVM
