# Generic kernel capabilities required for a native Linux Tailscale subnet
# router. Values marked "builtin" must be y; "available" accepts y or m.

CONFIG_NET=builtin
CONFIG_INET=builtin
CONFIG_IP_ADVANCED_ROUTER=builtin
CONFIG_NETFILTER=builtin
CONFIG_NF_TABLES=available
CONFIG_TUN=available
CONFIG_IPV6=available
