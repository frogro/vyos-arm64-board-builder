# Base A: available CPU policies for routing, VPN and optional workloads.
# Do not select CPU_FREQ_DEFAULT_GOV_*; preserve the existing default.
# Hardware CPUFreq drivers remain board-specific.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
